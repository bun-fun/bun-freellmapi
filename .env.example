# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Required in production. Outside production it is optional: when unset, a key is
# auto-generated and persisted in the local DB. Precedence: this env var, then
# the DB-stored key, then a freshly generated key.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Server port (default: 3001)
PORT=3001

# Network interface the server listens on. Default '0.0.0.0'.
# Set '::' for dual-stack IPv4+IPv6, or 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# Admin password (optional). If set, the admin password is synced to this value
# on every startup. If unset, a random password is generated on first run.
# ADMIN_PASSWORD=

# Hugging Face Dataset backup configuration
# HF_TOKEN: Hugging Face access token with write access to the dataset
# HF_DATASET_ID: Dataset repository ID, e.g. "username/freellmapi-backups"
# BACKUP_ENABLED: Set to "true" to enable automatic backup and restore
# BACKUP_INTERVAL_MS: Backup interval in milliseconds (default: 86400000 = 24h)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_DATASET_ID=username/freellmapi-backups
BACKUP_ENABLED=false
BACKUP_INTERVAL_MS=86400000

# Docker only: which host interface the container's port is published on.
# Defaults to 127.0.0.1, so the dashboard/API is reachable only from the
# machine running Docker. To open it to other devices on your LAN (e.g. a
# Raspberry Pi reached at http://192.168.1.x:3001), set HOST_BIND=0.0.0.0.
# Only do this on a trusted network — the proxy is single-user and guarded
# only by the unified API key.
# HOST_BIND=0.0.0.0

# Max /v1 proxy requests per minute per client IP (default: 120). Set to 0
# to disable proxy rate limiting.
# PROXY_RATE_LIMIT_RPM=120

# Max /api dashboard requests per minute per client IP (default: 600). This is a
# flood guard — login has its own per-email lockout and key export its own much
# tighter cap. Set to 0 to disable.
# ADMIN_RATE_LIMIT_RPM=600

# Outbound proxy for provider requests. Normally set in the dashboard
# (Keys → Outbound proxy); these env vars are for headless installs.
# Schemes: http, https, socks4, socks4a, socks5, socks5h. The `h`/`a` variants
# resolve DNS at the proxy, which is what you want on a DNS-poisoned network.
# Precedence: PROXY_URL → dashboard setting → ALL_PROXY → HTTPS_PROXY →
# HTTP_PROXY. The standard vars are also read in their lower-case spellings.
# PROXY_URL=socks5h://127.0.0.1:1080
# ALL_PROXY=socks5h://127.0.0.1:1080
# HTTPS_PROXY=http://proxy.corp.com:8080
# HTTP_PROXY=http://proxy.corp.com:8080

# Hosts that must be reached directly, bypassing the proxy above. Comma-
# separated; a bare domain also covers its subdomains, and `*` disables the
# proxy entirely.
# NO_PROXY=localhost,127.0.0.1,.internal.corp

# Per-provider daily request cap, named PROVIDER_DAILY_REQUEST_CAP_<PLATFORM>
# (platform name upper-cased). Overrides the built-in default for that provider;
# set to 0 to disable the cap. Example — cap OpenRouter at 50 requests/day:
# PROVIDER_DAILY_REQUEST_CAP_OPENROUTER=50

# Per-provider chat HTTP timeout in milliseconds, named
# PROVIDER_TIMEOUT_<PLATFORM> (platform name upper-cased). Overrides the
# built-in default for that provider (60s for most OpenAI-compatible platforms,
# 180s NVIDIA, 120s Ollama Cloud / AI Horde / custom providers, 60s Google as
# registered). On streaming requests this value also serves as the FIRST-BYTE
# grace budget. Set to 0 to disable the timeout entirely.
# PROVIDER_TIMEOUT_NVIDIA=300000

# Mid-stream inactivity timeout for streaming responses, in milliseconds
# (default: 90000). If an SSE stream goes this long without a single byte
# AFTER the first byte arrived, the gateway gives up on it. Set to 0 to disable.
# PROVIDER_STREAM_STALL_TIMEOUT_MS=90000
# PROVIDER_STREAM_STALL_TIMEOUT_OLLAMA=240000

# Wall-clock budget for provider failover, in milliseconds (default: 45000).
# FALLBACK_TIME_BUDGET_MS=45000

# Request guardrails, both OFF (0) by default.
# REQUEST_MAX_TOKENS_BUDGET=0
# MAX_CONSECUTIVE_UPSTREAM_FAILS=0

# Opt-in response cache. Off by default; set to true to enable.
# RESPONSE_CACHE=false
# RESPONSE_CACHE_TTL_SECONDS=3600
# RESPONSE_CACHE_MAX_TEMPERATURE=1.0
# RESPONSE_CACHE_MAX_ENTRIES=5000

# Request-side prompt/context compression. Default is off.
# FREELLMAPI_COMPRESSION=off

# Custom-provider URL policy. Block private/loopback URLs for custom providers.
# FREEAPI_BLOCK_PRIVATE_PROVIDER_URLS=true

# Request analytics retention. Set either value to 0 to disable that limit.
REQUEST_ANALYTICS_RETENTION_DAYS=90
REQUEST_ANALYTICS_MAX_ROWS=100000

# Per-request caller identity (client IP + User-Agent) recorded into request
# analytics. Set to false to store nulls instead.
# REQUEST_ANALYTICS_LOG_CLIENT=true

# Optional SQLite location.
# FREEAPI_DB_PATH=/app/server/data/freellmapi.db

# Optional encrypted SQLite backup.
# FREEAPI_DB_BACKUP_PATH=/app/server/data/freellmapi.db.backup
# FREEAPI_DB_BACKUP_URL=https://example.com/freellmapi.db.backup
# FREEAPI_DB_BACKUP_TOKEN=
# FREEAPI_DB_BACKUP_KEY=use-a-separate-64-char-hex-key-or-omit-to-use-ENCRYPTION_KEY
# FREEAPI_DB_BACKUP_INTERVAL_MS=300000

# Optional declarative startup config.
# FREEAPI_CONFIG_PATH=/app/server/data/freellmapi.config.json
# FREEAPI_CONFIG_JSON={"keys":[{"platform":"groq","key":"gsk_...","label":"main"}],"routing":{"strategy":"balanced"}}

# Context handoff on model switch. Off by default.
# FREELLMAPI_CONTEXT_HANDOFF=on_model_switch

# Comma-separated extra origins allowed to call the API from a browser.
# DASHBOARD_ORIGINS=http://my-server.local,http://192.168.1.50
